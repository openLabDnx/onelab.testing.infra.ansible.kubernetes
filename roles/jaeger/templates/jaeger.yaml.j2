# Jaeger v2, one pod with Badger storage (Managed by Ansible)
{% set jaeger_config = lookup('ansible.builtin.template', 'config.yaml.j2') %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
  labels: { app.kubernetes.io/name: jaeger }
data:
  config.yaml: |
    {{ jaeger_config | indent(4) }}
---
# StatefulSet with one replica: Badger allows a single writer, and the old pod
# is gone (database closed) before the new one starts.
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
  labels: { app.kubernetes.io/name: jaeger }
spec:
  serviceName: jaeger
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: jaeger }
  template:
    metadata:
      labels: { app.kubernetes.io/name: jaeger }
      annotations:
        # restart on a configuration change (Jaeger reads it at start only)
        checksum/config: {{ jaeger_config | hash('sha256') }}
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile: { type: RuntimeDefault }
      # primary site (Grafana, Prometheus, Loki), away from the 12 GiB
      # control-plane node when there is room
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: {{ platform_node_site_label }}
                    operator: In
                    values: [{{ platform_primary_site }}]
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist
      # time to flush and close Badger cleanly
      terminationGracePeriodSeconds: 60
      containers:
        - name: jaeger
          image: {{ jaeger_image }}
          args: ["--config=/etc/jaeger/config.yaml"]
          ports:
            - { name: otlp-grpc, containerPort: 4317 }
            - { name: otlp-http, containerPort: 4318 }
            - { name: http-query, containerPort: 16686 }
            - { name: grpc-query, containerPort: 16685 }
            - { name: health, containerPort: 13133 }
            - { name: metrics, containerPort: 8888 }
            - { name: spanmetrics, containerPort: 8889 }
          # opening a large Badger database takes a while
          startupProbe:
            httpGet: { path: /status, port: health }
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /status, port: health }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /status, port: health }
            periodSeconds: 20
            failureThreshold: 6
          resources:
            {{ jaeger_resources | to_nice_yaml(indent=2) | trim | indent(12) }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: ["ALL"] }
          volumeMounts:
            - { name: config, mountPath: /etc/jaeger, readOnly: true }
            - { name: data, mountPath: /badger }
            - { name: tmp, mountPath: /tmp }
      volumes:
        - name: config
          configMap: { name: jaeger }
        - name: tmp
          emptyDir: {}
  # immutable once created: see README before changing the size
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        storageClassName: {{ jaeger_storage_class }}
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: {{ jaeger_storage_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
  labels: { app.kubernetes.io/name: jaeger }
spec:
  selector: { app.kubernetes.io/name: jaeger }
  ports:
    - { name: otlp-grpc, port: 4317, targetPort: otlp-grpc }
    - { name: otlp-http, port: 4318, targetPort: otlp-http }
    - { name: http-query, port: 16686, targetPort: http-query }
    - { name: grpc-query, port: 16685, targetPort: grpc-query }
    - { name: metrics, port: 8888, targetPort: metrics }
    - { name: spanmetrics, port: 8889, targetPort: spanmetrics }
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
spec:
  selector:
    matchLabels: { app.kubernetes.io/name: jaeger }
  endpoints:
    - { port: metrics, interval: 30s }
    # request/error/latency per service and operation, with trace_id exemplars
    - { port: spanmetrics, interval: 30s }
---
# Jaeger has no login. OTLP only from Alloy (the apps' entry point), UI/API only
# from Traefik (behind authentik) and Grafana, metrics only from Prometheus.
# kubelet probes come from the pod's own node, which is always allowed.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
spec:
  podSelector:
    matchLabels: { app.kubernetes.io/name: jaeger }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels: { app.kubernetes.io/name: alloy }
      ports:
        - { port: 4317, protocol: TCP }
        - { port: 4318, protocol: TCP }
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: kube-system }
          podSelector:
            matchLabels: { app.kubernetes.io/name: rke2-traefik }
        - podSelector:
            matchLabels: { app.kubernetes.io/name: grafana }
      ports:
        - { port: 16686, protocol: TCP }
    - from:
        - podSelector:
            matchLabels: { app.kubernetes.io/name: prometheus }
      ports:
        - { port: 8888, protocol: TCP }
        - { port: 8889, protocol: TCP }
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: jaeger
  namespace: {{ observability_namespace }}
spec:
  groups:
    - name: jaeger
      rules:
        - alert: JaegerDown
          expr: absent(up{job="jaeger", namespace="{{ observability_namespace }}", endpoint="metrics"} == 1)
          for: 5m
          labels: { severity: critical }
          annotations:
            summary: Jaeger is down
            description: Traces are not stored and can't be searched. Alloy queues spans for a while, then drops them.
        - alert: JaegerRefusingSpans
          expr: sum(rate(otelcol_receiver_refused_spans{job="jaeger", namespace="{{ observability_namespace }}"}[5m])) > 0
          for: 10m
          labels: { severity: warning }
          annotations:
            summary: Jaeger refuses incoming spans
            description: Usually the memory limiter (raise jaeger_resources limits) or a malformed client.
        - alert: JaegerStorageWriteFailing
          expr: sum(rate(otelcol_exporter_send_failed_spans{job="jaeger", namespace="{{ observability_namespace }}"}[5m])) > 0
          for: 10m
          labels: { severity: critical }
          annotations:
            summary: Jaeger can't write spans to Badger
            description: Usually a full disk on the node that holds the jaeger PVC.
        - alert: JaegerStorageErrors
          expr: sum by (operation) (rate(jaeger_storage_requests{job="jaeger", namespace="{{ observability_namespace }}", result!="ok"}[5m])) > 0
          for: 15m
          labels: { severity: warning }
          annotations:
            summary: "Jaeger storage {{ '{{' }} $labels.operation }} requests fail"
            description: Searches or writes against Badger return errors.
