# Traefik dashboard behind authentik forward-auth (Managed by Ansible)
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: traefik-dashboard
  namespace: kube-system
  annotations:
    # RKE2 runs the CRD provider with --providers.kubernetescrd.ingressClass=traefik
    kubernetes.io/ingress.class: traefik
spec:
  entryPoints: [web]
  routes:
    # authentik's sign-in/callback endpoints for this host
    - match: Host(`{{ traefik_dashboard_host }}`) && PathPrefix(`/outpost.goauthentik.io/`)
      kind: Rule
      priority: 100
      services:
        - name: authentik-server
          namespace: {{ authentik_namespace }}
          port: 80
    - match: Host(`{{ traefik_dashboard_host }}`)
      kind: Rule
      middlewares:
        - name: authentik-forward-auth
          namespace: {{ authentik_namespace }}
      services:
        - name: api@internal
          kind: TraefikService
