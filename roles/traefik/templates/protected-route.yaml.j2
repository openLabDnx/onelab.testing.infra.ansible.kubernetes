# {{ route_host }} behind authentik forward-auth (Managed by Ansible)
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ route_name }}
  namespace: {{ route_namespace }}
  annotations:
    # RKE2 runs the CRD provider with --providers.kubernetescrd.ingressClass=traefik
    kubernetes.io/ingress.class: traefik
spec:
  entryPoints: [web]
  routes:
    # authentik's sign-in/callback endpoints for this host
    - match: Host(`{{ route_host }}`) && PathPrefix(`/outpost.goauthentik.io/`)
      kind: Rule
      priority: 100
      services:
        - name: authentik-server
          namespace: {{ authentik_namespace }}
          port: 80
    - match: Host(`{{ route_host }}`)
      kind: Rule
      middlewares:
        - name: authentik-forward-auth
          namespace: {{ authentik_namespace }}
      services:
        - name: {{ route_service }}
          port: {{ route_port }}
