# Super-admin web app (Managed by Ansible)
# https://{{ superadmin_host }}/     -> Traefik -> super-admin:80 -> pods :3008 (static app)
# https://{{ superadmin_host }}/api/ -> Traefik -> {{ superadmin_api_service }}:{{ superadmin_api_port }} (Super Admin API,
#   deployed separately; it signs people in against {{ superadmin_ldap_url }}).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: super-admin
  namespace: {{ superadmin_namespace }}
  labels: { app.kubernetes.io/name: super-admin }
spec:
  replicas: {{ superadmin_replicas }}
  selector:
    matchLabels: { app.kubernetes.io/name: super-admin }
  strategy:
    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
  template:
    metadata:
      labels: { app.kubernetes.io/name: super-admin }
    spec:
      nodeSelector: {{ platform_primary_site_selector | to_json }}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: { app.kubernetes.io/name: super-admin }
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000                              # "node" in node:24-alpine
        runAsGroup: 1000
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: super-admin
          image: {{ superadmin_image }}
          imagePullPolicy: Always
          ports:
            - { name: http, containerPort: 3008 }
          env:
            - { name: NODE_ENV, value: production }
            - { name: PORT, value: "3008" }
          readinessProbe:
            httpGet: { path: /healthz, port: http }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /healthz, port: http }
            periodSeconds: 20
            failureThreshold: 3
          resources: {{ superadmin_resources | to_json }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: super-admin
  namespace: {{ superadmin_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels: { app.kubernetes.io/name: super-admin }
---
apiVersion: v1
kind: Service
metadata:
  name: super-admin
  namespace: {{ superadmin_namespace }}
  labels: { app.kubernetes.io/name: super-admin }
spec:
  selector: { app.kubernetes.io/name: super-admin }
  ports:
    - { name: http, port: 80, targetPort: http }
---
# The app has its own LDAP login, so no authentik forward-auth in front of it.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: super-admin
  namespace: {{ superadmin_namespace }}
  annotations:
    # RKE2 runs the CRD provider with --providers.kubernetescrd.ingressClass=traefik
    kubernetes.io/ingress.class: traefik
spec:
  entryPoints: [web]
  routes:
    # Same origin for the app and its API, so the session cookie stays SameSite=Strict.
    - match: Host(`{{ superadmin_host }}`) && PathPrefix(`/api/`)
      kind: Rule
      priority: 100
      services:
        - name: {{ superadmin_api_service }}
          port: {{ superadmin_api_port }}
    - match: Host(`{{ superadmin_host }}`)
      kind: Rule
      services:
        - name: super-admin
          port: 80
---
# Only Traefik reaches the app. The probes come from the pod's own node.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: super-admin
  namespace: {{ superadmin_namespace }}
spec:
  podSelector:
    matchLabels: { app.kubernetes.io/name: super-admin }
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: kube-system }
          podSelector:
            matchLabels: { app.kubernetes.io/name: rke2-traefik }
      ports:
        - { port: 3008, protocol: TCP }
