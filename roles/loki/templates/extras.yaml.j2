# Loki NetworkPolicy and alerts (Managed by Ansible)
# Loki has no login: whoever reaches port 3100 can read every log line or push
# fake ones. Only Alloy (push), Grafana (queries) and Prometheus (metrics) get in;
# kubelet probes come from the pod's own node, which is always allowed.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: loki
  namespace: {{ observability_namespace }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: loki
      app.kubernetes.io/instance: loki
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels: { app.kubernetes.io/name: alloy }
        - podSelector:
            matchLabels: { app.kubernetes.io/name: grafana }
        - podSelector:
            matchLabels: { app.kubernetes.io/name: prometheus }
      ports:
        - { port: 3100, protocol: TCP }
    # Loki to itself: memberlist and gRPC (compactor)
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: loki
              app.kubernetes.io/instance: loki
      ports:
        - { port: 7946, protocol: TCP }
        - { port: 9095, protocol: TCP }
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: loki
  namespace: {{ observability_namespace }}
spec:
  groups:
    - name: loki
      rules:
        - alert: LokiDown
          expr: absent(up{job="{{ loki_metrics_job }}"} == 1)
          for: 5m
          labels: { severity: critical }
          annotations:
            summary: Loki is down
            description: No logs are stored and Grafana can't query any. Alloy keeps retrying and catches up from its positions once Loki is back.
        - alert: LokiRequestErrors
          expr: |
            100 * sum by (route) (rate(loki_request_duration_seconds_count{job="{{ loki_metrics_job }}", status_code=~"5.."}[5m]))
              / sum by (route) (rate(loki_request_duration_seconds_count{job="{{ loki_metrics_job }}"}[5m])) > 10
          for: 15m
          labels: { severity: warning }
          annotations:
            summary: "Loki: {{ '{{' }} $value | humanize }}% of {{ '{{' }} $labels.route }} requests fail"
            description: More than 10% of the requests on this route return 5xx.
        - alert: LokiDiscardingLogs
          expr: sum by (reason) (rate(loki_discarded_samples_total{job="{{ loki_metrics_job }}"}[10m])) > 0
          for: 15m
          labels: { severity: warning }
          annotations:
            summary: "Loki rejects log lines ({{ '{{' }} $labels.reason }})"
            description: Lines are being dropped. rate_limited / per_stream_rate_limit = raise the limits in roles/loki/defaults; greater_than_max_sample_age = a source sends lines older than 7 days.
        - alert: LokiChunkFlushFailing
          expr: increase(loki_ingester_chunks_flush_failures_total{job="{{ loki_metrics_job }}"}[15m]) > 0
          labels: { severity: critical }
          annotations:
            summary: Loki can't write chunks to its volume
            description: Usually a full or read-only disk on the node that holds the loki PVC.
        - alert: LokiWALDiskFull
          expr: increase(loki_ingester_wal_disk_full_failures_total{job="{{ loki_metrics_job }}"}[5m]) > 0
          labels: { severity: critical }
          annotations:
            summary: Loki's write-ahead log hit a full disk
            description: Logs received now are lost if Loki restarts. Free space on the node that holds the loki PVC.
        - alert: LokiRetentionNotRunning
          expr: time() - max(loki_compactor_apply_retention_last_successful_run_timestamp_seconds{job="{{ loki_metrics_job }}"}) > 3 * 3600
          for: 1h
          labels: { severity: warning }
          annotations:
            summary: Loki has not deleted old logs for 3 hours
            description: The compactor's retention isn't running, so the log volume keeps growing.
