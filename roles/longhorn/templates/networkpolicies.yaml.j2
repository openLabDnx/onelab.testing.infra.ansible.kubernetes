# Longhorn NetworkPolicies (Managed by Ansible), next to the chart's own
# (restrictInternalTraffic), which let only Longhorn's components reach the
# managers. NetworkPolicies add up: these open just the two extra paths below.
# kubelet probes come from the pod's own node, which is always allowed.
#
# The UI has no login of its own: only Traefik, which asks authentik first
# (tasks/ui.yaml), may reach it.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: longhorn-ui
  namespace: {{ longhorn_namespace }}
spec:
  podSelector:
    matchLabels: { app: longhorn-ui }
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: kube-system }
          podSelector:
            matchLabels: { app.kubernetes.io/name: rke2-traefik }
      ports:
        - { port: 8000, protocol: TCP }
---
# Prometheus scrapes /metrics on the managers' API port (ServiceMonitor in
# roles/monitoring). That port also serves the whole API, which has no login,
# so it is opened to the Prometheus pods only.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: longhorn-manager-metrics
  namespace: {{ longhorn_namespace }}
spec:
  podSelector:
    matchLabels: { app: longhorn-manager }
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ observability_namespace }} }
          podSelector:
            matchLabels: { app.kubernetes.io/name: prometheus }
      ports:
        - { port: 9500, protocol: TCP }
