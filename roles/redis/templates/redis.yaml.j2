# Redis for the apps (Managed by Ansible)
# In cluster: redis.{{ redis_namespace }}.svc.cluster.local:6379, password in Secret redis-auth.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: {{ redis_namespace }}
  labels: { app.kubernetes.io/name: redis }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: redis }
  template:
    metadata:
      labels: { app.kubernetes.io/name: redis }
      annotations:
        # a new password rolls the pod, which reads it from the Secret only at start
        autofik.com/password-sha256: "{{ redis_password | hash('sha256') }}"
    spec:
      nodeSelector: {{ platform_primary_site_selector | to_json }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: redis
          image: {{ redis_image }}
          command: [sh, -c]
          # no RDB snapshots, no AOF: nothing in here has to outlive the pod
          args:
            - >-
              exec redis-server --requirepass "$REDIS_PASSWORD"
              --save "" --appendonly no
              --maxmemory {{ redis_maxmemory }} --maxmemory-policy allkeys-lru
          env:
            - name: REDIS_PASSWORD
              valueFrom: { secretKeyRef: { name: redis-auth, key: password } }
            - name: REDISCLI_AUTH                   # redis-cli in the probes
              valueFrom: { secretKeyRef: { name: redis-auth, key: password } }
          ports:
            - { name: redis, containerPort: 6379 }
          readinessProbe:
            exec: { command: [sh, -c, "redis-cli ping | grep -q PONG"] }
            periodSeconds: 5
          livenessProbe:
            exec: { command: [sh, -c, "redis-cli ping | grep -q PONG"] }
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            {{ redis_resources | to_nice_yaml(indent=2) | trim | indent(12) }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          volumeMounts:
            - { name: data, mountPath: /data }
      volumes:
        - { name: data, emptyDir: {} }
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ redis_namespace }}
  labels: { app.kubernetes.io/name: redis }
spec:
  selector: { app.kubernetes.io/name: redis }
  ports:
    - { name: redis, port: 6379, targetPort: redis }
---
# Only the namespaces in redis_client_namespaces. The probes run inside the pod.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: redis
  namespace: {{ redis_namespace }}
spec:
  podSelector:
    matchLabels: { app.kubernetes.io/name: redis }
  policyTypes: [Ingress]
  ingress:
    - from:
{% for ns in redis_client_namespaces %}
        - namespaceSelector:
            matchLabels: { kubernetes.io/metadata.name: {{ ns }} }
{% endfor %}
      ports:
        - { port: 6379, protocol: TCP }
