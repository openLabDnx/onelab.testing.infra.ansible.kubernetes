# authentik forward-auth for Traefik (Managed by Ansible). Any IngressRoute can
# use it as authentik-forward-auth in namespace {{ authentik_namespace }}.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authentik-forward-auth
  namespace: {{ authentik_namespace }}
spec:
  forwardAuth:
    address: {{ authentik_internal_url }}/outpost.goauthentik.io/auth/traefik
    trustForwardHeader: true
    authResponseHeaders:
      - X-authentik-username
      - X-authentik-groups
      - X-authentik-email
      - X-authentik-name
      - X-authentik-uid
