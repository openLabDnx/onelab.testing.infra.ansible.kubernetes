# authentik platform blueprint (Managed by Ansible). Applied by the worker on
# start and by `make authentik`; client secrets come from the worker's env.
version: 1
metadata:
  name: autofik-platform
  labels:
    blueprints.goauthentik.io/description: "SSO for Argo CD, Portainer and the Traefik dashboard; LDAP for the super-admin app"
entries:
  # --- admins -------------------------------------------------------------
  - model: authentik_core.group
    id: platform-admins
    identifiers:
      name: {{ platform_admin_group }}
    attrs:
      users:
        - !Find [authentik_core.user, [username, akadmin]]

  # --- Argo CD (OIDC) -------------------------------------------------------
  - model: authentik_providers_oauth2.oauth2provider
    id: argocd-provider
    identifiers:
      name: argocd
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      # authentik 2026.8: providers created via blueprint allow no grant type by default
      grant_types: [authorization_code, refresh_token]
      client_id: {{ argocd_oidc_client_id }}
      client_secret: !Env ARGOCD_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: https://{{ argocd_host }}/auth/callback
        - matching_mode: strict
          url: http://localhost:8085/auth/callback      # argocd login --sso
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      include_claims_in_id_token: true
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
  - model: authentik_core.application
    id: argocd-app
    identifiers:
      slug: argocd
    attrs:
      name: Argo CD
      provider: !KeyOf argocd-provider
      meta_launch_url: https://{{ argocd_host }}/
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf argocd-app
      group: !KeyOf platform-admins
    attrs:
      order: 0

  # --- Portainer (OIDC) -----------------------------------------------------
  - model: authentik_providers_oauth2.oauth2provider
    id: portainer-provider
    identifiers:
      name: portainer
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types: [authorization_code, refresh_token]
      client_id: {{ portainer_oidc_client_id }}
      client_secret: !Env PORTAINER_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: https://{{ portainer_host }}/
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
  - model: authentik_core.application
    id: portainer-app
    identifiers:
      slug: portainer
    attrs:
      name: Portainer
      provider: !KeyOf portainer-provider
      meta_launch_url: https://{{ portainer_host }}/
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf portainer-app
      group: !KeyOf platform-admins
    attrs:
      order: 0

  # --- Grafana (OIDC; platform-admins become Grafana Admin) ------------------
  - model: authentik_providers_oauth2.oauth2provider
    id: grafana-provider
    identifiers:
      name: grafana
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      grant_types: [authorization_code, refresh_token]
      client_id: {{ grafana_oidc_client_id }}
      client_secret: !Env GRAFANA_OIDC_CLIENT_SECRET
      redirect_uris:
        - matching_mode: strict
          url: https://{{ grafana_host }}/login/generic_oauth
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
  - model: authentik_core.application
    id: grafana-app
    identifiers:
      slug: grafana
    attrs:
      name: Grafana
      provider: !KeyOf grafana-provider
      meta_launch_url: https://{{ grafana_host }}/
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf grafana-app
      group: !KeyOf platform-admins
    attrs:
      order: 0

  # --- forward-auth apps (embedded outpost; platform_forward_auth_apps) ------
{% for app in platform_forward_auth_apps %}
  - model: authentik_providers_proxy.proxyprovider
    id: {{ app.slug }}-provider
    identifiers:
      name: {{ app.slug }}
    attrs:
      mode: forward_single
      external_host: https://{{ app.host }}
      # the app's own Authorization header (e.g. RabbitMQ's Basic auth) is not an authentik login
      intercept_header_auth: false
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    id: {{ app.slug }}-app
    identifiers:
      slug: {{ app.slug }}
    attrs:
      name: {{ app.name }}
      provider: !KeyOf {{ app.slug }}-provider
      meta_launch_url: https://{{ app.host }}{{ app.launch_path }}
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf {{ app.slug }}-app
      group: !KeyOf platform-admins
    attrs:
      order: 0
{% endfor %}

  - model: authentik_outposts.outpost
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
{% for app in platform_forward_auth_apps %}
        - !KeyOf {{ app.slug }}-provider
{% endfor %}
      config:
        authentik_host: https://{{ authentik_host }}
{% if authentik_ldap_enabled %}

  # --- super-admin web app (LDAP; outpost run by authentik, tasks/ldap.yaml) -----
  # Members are added by Ansible and in the UI: a `users` attr here would replace
  # the whole member list on every apply.
  - model: authentik_core.group
    id: super-admins
    identifiers:
      name: {{ superadmin_group }}
  - model: authentik_providers_ldap.ldapprovider
    id: super-admin-ldap-provider
    identifiers:
      name: super-admin-ldap
    attrs:
      # LDAP "Bind flow" (MFA included: TOTP users send password;code) and
      # "Unbind flow" (its logout stage ends the session each bind creates)
      authorization_flow: !Find [authentik_flows.flow, [slug, default-authentication-flow]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-invalidation-flow]]
      base_dn: {{ authentik_ldap_base_dn }}
      bind_mode: direct
      search_mode: direct
      mfa_support: true
  - model: authentik_core.application
    id: super-admin-ldap-app
    identifiers:
      slug: super-admin-ldap
    attrs:
      name: Super-admin console (LDAP)
      provider: !KeyOf super-admin-ldap-provider
      meta_hide: true
  # Without a binding every active user could bind.
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf super-admin-ldap-app
      group: !KeyOf super-admins
    attrs:
      order: 0
  # Created by the worker on its own when authentik runs in the cluster; declared
  # so the outpost below never ends up without a connection.
  - model: authentik_outposts.kubernetesserviceconnection
    id: local-k8s
    identifiers:
      name: Local Kubernetes Cluster
    attrs:
      local: true
  - model: authentik_outposts.outpost
    identifiers:
      name: {{ authentik_ldap_outpost_name }}
    attrs:
      type: ldap
      service_connection: !KeyOf local-k8s
      providers:
        - !KeyOf super-admin-ldap-provider
      config:
        authentik_host: {{ authentik_internal_url }}
        kubernetes_namespace: {{ authentik_namespace }}
        kubernetes_replicas: {{ authentik_ldap_outpost_replicas }}
        kubernetes_service_type: ClusterIP
        kubernetes_json_patches:
          deployment:
            - op: add
              path: /spec/template/spec/nodeSelector
              value: {{ platform_primary_site_selector | to_json }}
            - op: add
              path: /spec/template/spec/topologySpreadConstraints
              value:
                - maxSkew: 1
                  topologyKey: kubernetes.io/hostname
                  whenUnsatisfiable: ScheduleAnyway
                  labelSelector:
                    matchLabels: { goauthentik.io/outpost-name: {{ authentik_ldap_outpost_name }} }
            - op: add
              path: /spec/template/spec/containers/0/resources
              value: {{ authentik_ldap_outpost_resources | to_json }}
{% endif %}
