# kafbat Kafka UI, read-only, behind authentik forward-auth (Managed by Ansible)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kafka-ui
  namespace: {{ kafka_namespace }}
  labels: { app: kafka-ui }
spec:
  replicas: {{ kafka_ui_replicas }}
  selector:
    matchLabels: { app: kafka-ui }
  template:
    metadata:
      labels: { app: kafka-ui }
    spec:
      nodeSelector:
        {{ platform_primary_site_selector | to_nice_yaml | trim | indent(8) }}
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels: { app: kafka-ui }
      securityContext:
        runAsNonRoot: true
        runAsUser: 100
      containers:
        - name: kafka-ui
          image: {{ kafka_ui_image }}
          ports:
            - { name: http, containerPort: 8080 }
          env:
            - { name: AUTH_TYPE, value: DISABLED }           # authentik in front
            - { name: DYNAMIC_CONFIG_ENABLED, value: "false" }
            - { name: KAFKA_CLUSTERS_0_NAME, value: {{ platform_domain | replace('.', '-') }} }
            - { name: KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS, value: "{{ kafka_cluster_name }}-kafka-bootstrap:9092" }
            - { name: KAFKA_CLUSTERS_0_READONLY, value: "true" }
            - { name: KAFKA_CLUSTERS_0_PROPERTIES_SECURITY_PROTOCOL, value: SASL_PLAINTEXT }
            - { name: KAFKA_CLUSTERS_0_PROPERTIES_SASL_MECHANISM, value: SCRAM-SHA-512 }
            - name: KAFKA_CLUSTERS_0_PROPERTIES_SASL_JAAS_CONFIG
              valueFrom:
                secretKeyRef: { name: kafka-ui, key: sasl.jaas.config }
          readinessProbe:
            httpGet: { path: /actuator/health, port: http }
            periodSeconds: 10
          livenessProbe:
            httpGet: { path: /actuator/health, port: http }
            initialDelaySeconds: 60
            periodSeconds: 20
          resources:
            requests: { cpu: 50m, memory: 384Mi }
            limits: { memory: 768Mi }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: ["ALL"] }
---
apiVersion: v1
kind: Service
metadata:
  name: kafka-ui
  namespace: {{ kafka_namespace }}
spec:
  selector: { app: kafka-ui }
  ports:
    - { name: http, port: 8080, targetPort: http }
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: kafka-ui
  namespace: {{ kafka_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels: { app: kafka-ui }
