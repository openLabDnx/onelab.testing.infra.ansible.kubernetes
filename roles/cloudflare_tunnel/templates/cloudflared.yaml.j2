# cloudflared connectors (Managed by Ansible)
# All replicas run the same tunnel; Cloudflare spreads traffic across them.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: {{ cloudflared_namespace }}
  labels:
    app: cloudflared
spec:
  replicas: {{ cloudflared_replicas }}
  selector:
    matchLabels:
      app: cloudflared
  template:
    metadata:
      labels:
        app: cloudflared
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                topologyKey: kubernetes.io/hostname
                labelSelector:
                  matchLabels:
                    app: cloudflared
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        sysctls:
          # lets cloudflared proxy ICMP (ping/traceroute) as an unprivileged user
          - name: net.ipv4.ping_group_range
            value: "65532 65532"
      containers:
        - name: cloudflared
          image: {{ cloudflared_image }}
          args:
            - tunnel
            - --no-autoupdate
            - --metrics
            - 0.0.0.0:2000
            - run
          env:
            # read by `cloudflared tunnel run`; kept out of the container args
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: cloudflared-token
                  key: token
          ports:
            - name: metrics
              containerPort: 2000
          readinessProbe:
            httpGet:
              path: /ready
              port: 2000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: 2000
            initialDelaySeconds: 20
            periodSeconds: 10
            failureThreshold: 6
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
            limits:
              memory: 256Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
{% if cloudflare_vault_enabled %}
          volumeMounts:
            - name: vault-ca
              mountPath: {{ cloudflared_vault_ca_mount }}
              readOnly: true
      volumes:
        - name: vault-ca
          configMap:
            name: vault-ca
{% endif %}
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: cloudflared
  namespace: {{ cloudflared_namespace }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: cloudflared
